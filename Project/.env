# ------------------------------------------------------------
# Backend application settings (backend/app/core/config.py)
# ------------------------------------------------------------
APP_NAME=FastAPI App
VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=templates
HYBRID_ALPHA=0.7
POSTGRES_DSN=postgresql://appuser:apppassword@localhost:5432/appdb
STORAGE_ADAPTER=postgres
OUTBOX_POLL_INTERVAL=5.0
OUTBOX_MAX_RETRIES=5

# ------------------------------------------------------------
# Frontend runtime setting (frontend/pages/*.py)
# ------------------------------------------------------------
BACKEND_URL=http://localhost:8000

# ------------------------------------------------------------
# App container defaults from docker-compose.yml (app service)
# ------------------------------------------------------------
# Use these when running the full Docker stack.
# In Docker, hostnames should be service names (milvus, postgres).
# APP_NAME=FastAPI App
# VERSION=0.1.0
# ENVIRONMENT=production
# MILVUS_URI=http://milvus:19530
# POSTGRES_DSN=postgresql://appuser:apppassword@postgres:5432/appdb
# STORAGE_ADAPTER=postgres
HF_HOME=/root/.cache/huggingface
LIBRARY_PATH=/usr/lib/aarch64-linux-gnu:/lib/aarch64-linux-gnu
LD_LIBRARY_PATH=/usr/lib/aarch64-linux-gnu:/lib/aarch64-linux-gnu

# ------------------------------------------------------------
# PostgreSQL service defaults (docker-compose.yml)
# ------------------------------------------------------------
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppassword

# ------------------------------------------------------------
# etcd service defaults (docker-compose.yml)
# ------------------------------------------------------------
ETCD_AUTO_COMPACTION_MODE=revision
ETCD_AUTO_COMPACTION_RETENTION=1000
ETCD_QUOTA_BACKEND_BYTES=4294967296
ETCD_SNAPSHOT_COUNT=50000

# ------------------------------------------------------------
# vLLM (host-side model serving)
# ------------------------------------------------------------
# REQUIRED — path to the Python venv with vLLM installed (no default).
# Example: /home/yourname/Documents/model-expose/.venv
VLLM_VENV=/home/dellpromax/Documents/model-expose/.venv

# Ports for the two vLLM servers. Change only if the defaults conflict.
QWEN_TEXT_PORT=8001
QWEN_VL_PORT=8002

# GPU memory fractions (of the unified pool). Sum should stay well below 1.0.
QWEN_TEXT_GPU=0.14
QWEN_VL_GPU=0.20

# Seconds to wait for each server to pass its /health check (default: 15 min).
READY_TIMEOUT=900

# HuggingFace cache root on the HOST (not the Docker container).
# Leave empty to use $HOME/.cache/huggingface.
VLLM_HF_HOME=

# ------------------------------------------------------------
# MinIO service defaults (docker-compose.yml)
# ------------------------------------------------------------
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ------------------------------------------------------------
# Milvus service defaults (docker-compose.yml)
# ------------------------------------------------------------
ETCD_ENDPOINTS=etcd:2379
MINIO_ADDRESS=minio:9000
